# Application
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:5173"]

# Database (Postgres via Supabase or local)
# For Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# For local: postgresql://postgres:password@localhost:5432/daily_money_tracker
DATABASE_URL=postgresql://postgres:password@localhost:5432/daily_money_tracker

# Scheduler
SCHEDULER_ENABLED=true

# VAPID Push Notifications
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@example.com

# JWT
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# LLM API (optional - for AI features)
LLM_API_KEY=
LLM_API_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
